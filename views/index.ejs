<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            navy: {
              DEFAULT: '#0b1f3f',
              light: '#15294f',
              dark: '#071528',
            },
            sunset: {
              DEFAULT: '#f5a623',
              dark: '#dc8e0f',
            },
          },
        },
      },
    };
  </script>
  <!--
    Cegah "flash" putih sebelum JS lain jalan: baca preferensi dark mode
    dari localStorage SEBELUM body di-render.
  -->
  <script>
    if (
      localStorage.getItem('theme') === 'dark' ||
      (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors">

  <!-- NAVBAR -->
  <header class="bg-navy border-b border-navy-dark sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-white tracking-wide">
          <%= storeName %>
        </h1>
        <p class="text-xs text-sunset font-semibold uppercase tracking-wider">Katalog produk & keranjang</p>
      </div>

      <div class="flex items-center gap-3">
        <!-- tombol login admin (keliatan kalo BELUM login) -->
        <button
          id="admin-login-btn"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-navy-light text-white hover:bg-navy-dark transition-colors"
          title="Login admin"
        >
          🛡️
        </button>

        <!-- status admin + link dashboard + tombol logout (keliatan kalo SUDAH login), lihat public/js/admin.js -->
        <div id="admin-status" class="hidden items-center gap-2 bg-navy-light rounded-full pl-3 pr-1 py-1">
          <a href="/admin" class="text-xs text-white font-semibold whitespace-nowrap hover:text-sunset">🛠️ Dashboard</a>
          <button
            id="admin-logout-btn"
            class="w-7 h-7 flex items-center justify-center rounded-full bg-sunset hover:bg-sunset-dark text-white text-xs transition-colors"
            title="Logout"
          >⏻</button>
        </div>

        <!-- toggle dark/light mode -->
        <button
          id="theme-toggle"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-navy-light text-white hover:bg-navy-dark transition-colors"
          title="Ganti tema"
        >
          <span id="theme-icon">🌙</span>
        </button>

        <!-- tombol wishlist, badge jumlah favorit di-render dari wishlistStore (state), bukan hardcode -->
        <button
          id="wishlist-toggle"
          class="relative w-10 h-10 flex items-center justify-center rounded-full bg-navy-light text-white hover:bg-navy-dark transition-colors"
          title="Buka favorit"
        >
          🤍
          <span
            id="wishlist-badge"
            class="hidden absolute -top-1 -right-1 bg-rose-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center border-2 border-navy"
          >0</span>
        </button>

        <!-- tombol keranjang, angkanya (badge) di-render dari state, bukan hardcode -->
        <button
          id="cart-toggle"
          class="relative w-10 h-10 flex items-center justify-center rounded-full bg-navy-light text-white hover:bg-navy-dark transition-colors"
          title="Buka keranjang"
        >
          🛒
          <span
            id="cart-badge"
            class="hidden absolute -top-1 -right-1 bg-sunset text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center border-2 border-navy"
          >0</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-6">
    <div class="flex flex-col gap-3 mb-4">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <h2 class="font-extrabold text-navy dark:text-white uppercase tracking-wide text-sm">Produk Kami</h2>

        <div class="flex items-center gap-2 flex-wrap">
          <div id="filter-buttons" class="flex gap-2">
            <button data-filter="all" class="filter-btn px-4 py-1.5 text-xs font-bold uppercase tracking-wide rounded-full bg-sunset text-white shadow-sm">Semua</button>
            <button data-filter="available" class="filter-btn px-4 py-1.5 text-xs font-bold uppercase tracking-wide rounded-full bg-white dark:bg-gray-700 border border-navy/20 dark:border-gray-600 text-navy dark:text-gray-300">Tersedia</button>
            <button data-filter="out" class="filter-btn px-4 py-1.5 text-xs font-bold uppercase tracking-wide rounded-full bg-white dark:bg-gray-700 border border-navy/20 dark:border-gray-600 text-navy dark:text-gray-300">Habis</button>
          </div>
        </div>
      </div>

      <!-- pencarian & pengurutan: sama-sama nyambung ke productStore, memicu render ulang list -->
      <div class="flex items-center gap-2 flex-wrap">
        <input
          id="search-input"
          type="text"
          placeholder="Cari produk..."
          class="flex-1 min-w-[160px] px-4 py-2 text-sm rounded-full border border-navy/20 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sunset"
        />
        <select
          id="sort-select"
          class="px-4 py-2 text-sm rounded-full border border-navy/20 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sunset"
        >
          <option value="default">Urutan default</option>
          <option value="price-asc">Harga: Rendah ke Tinggi</option>
          <option value="price-desc">Harga: Tinggi ke Rendah</option>
          <option value="name-asc">Nama: A-Z</option>
        </select>
      </div>
    </div>

    <!-- render awal dari server (SSR), difilter ulang di client tanpa reload -->
    <div id="product-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% products.forEach(function(product) { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>

    <p id="empty-state" class="hidden text-center text-gray-400 dark:text-gray-500 py-8">
      Gak ada produk yang cocok sama filter ini
    </p>
  </main>

  <!-- OVERLAY + DRAWER KERANJANG (murni client-rendered, isinya dari cartStore) -->
  <div id="cart-overlay" class="hidden fixed inset-0 bg-black/40 z-20"></div>

  <aside
    id="cart-drawer"
    class="fixed top-0 right-0 h-full w-full sm:w-96 bg-white dark:bg-gray-800 shadow-2xl z-30 translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="flex items-center justify-between px-4 py-4 bg-navy">
      <h2 class="font-bold text-white uppercase tracking-wide text-sm">Keranjang Belanja</h2>
      <button id="cart-close" class="text-white/70 hover:text-white text-xl">✕</button>
    </div>

    <div id="cart-items" class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
      <!-- item keranjang di-render di sini lewat JS -->
    </div>

    <div class="border-t border-gray-200 dark:border-gray-700 px-4 py-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500 dark:text-gray-400">Total</span>
        <span id="cart-total" class="font-bold text-lg text-navy dark:text-white">Rp0</span>
      </div>
      <button
        id="checkout-btn"
        class="w-full bg-sunset hover:bg-sunset-dark text-white font-bold uppercase tracking-wide py-2.5 rounded-full text-sm transition-colors"
      >
        Checkout
      </button>
    </div>
  </aside>

  <!-- OVERLAY + DRAWER WISHLIST (murni client-rendered, isinya dari wishlistStore) -->
  <div id="wishlist-overlay" class="hidden fixed inset-0 bg-black/40 z-20"></div>

  <aside
    id="wishlist-drawer"
    class="fixed top-0 right-0 h-full w-full sm:w-96 bg-white dark:bg-gray-800 shadow-2xl z-30 translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="flex items-center justify-between px-4 py-4 bg-navy">
      <h2 class="font-bold text-white uppercase tracking-wide text-sm">Produk Favorit</h2>
      <button id="wishlist-close" class="text-white/70 hover:text-white text-xl">✕</button>
    </div>

    <div id="wishlist-items" class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
      <!-- item wishlist di-render di sini lewat JS -->
    </div>
  </aside>

  <!-- MODAL: pesanan berhasil di-checkout -->
  <div id="checkout-modal" class="hidden fixed inset-0 z-40 flex items-center justify-center px-4">
    <div id="checkout-modal-overlay" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden text-center">
      <div class="pt-8 pb-5 px-6">
        <div class="w-16 h-16 mx-auto rounded-full bg-sunset/10 flex items-center justify-center mb-4">
          <span class="text-3xl">✅</span>
        </div>
        <h3 class="text-lg font-extrabold text-navy dark:text-white mb-1">Pesanan Berhasil!</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Pesanan kamu berhasil di-checkout. Terima kasih sudah belanja di
          <span class="font-semibold text-navy dark:text-sunset"><%= storeName %></span>.
        </p>
      </div>
      <button
        id="checkout-modal-close"
        class="w-full bg-sunset hover:bg-sunset-dark text-white font-bold uppercase tracking-wide py-3 text-sm transition-colors"
      >OK</button>
    </div>
  </div>

  <!-- MODAL: login admin -->
  <div id="admin-login-overlay" class="hidden fixed inset-0 z-40 flex items-center justify-center px-4">
    <div id="admin-login-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
      <div class="bg-navy px-5 py-4 flex items-center justify-between">
        <h3 class="text-white font-bold uppercase tracking-wide text-sm">🛡️ Login Admin</h3>
        <button id="admin-login-close" class="text-white/70 hover:text-white text-xl">✕</button>
      </div>
      <form id="admin-login-form" class="px-5 py-5 space-y-3">
        <div>
          <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Username</label>
          <input id="admin-username" type="text" required autocomplete="username" class="w-full mt-1 px-3 py-2 text-sm rounded-lg border border-navy/20 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sunset" />
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Password</label>
          <input id="admin-password" type="password" required autocomplete="current-password" class="w-full mt-1 px-3 py-2 text-sm rounded-lg border border-navy/20 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sunset" />
        </div>
        <p id="admin-login-error" class="hidden text-xs text-red-500"></p>
        <button
          type="submit"
          class="w-full bg-sunset hover:bg-sunset-dark text-white font-bold uppercase tracking-wide py-2.5 rounded-full text-sm transition-colors"
        >Masuk</button>
      </form>
    </div>
  </div>

  <!-- container notifikasi toast, di-render dari toastStore (public/js/toast.js) -->
  <div id="toast-container" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center gap-2"></div>

  <script>
    window.__INITIAL_PRODUCTS__ = <%- JSON.stringify(products) %>;
    window.__IS_ADMIN__ = <%- JSON.stringify(isAdmin) %>;
  </script>

  <script src="/js/store.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/products.js"></script>
  <script src="/js/wishlist.js"></script>
  <script src="/js/cart.js"></script>
  <script src="/js/checkout.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
